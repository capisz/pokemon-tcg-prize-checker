# Copy to .env.local. Web app configuration is from Firebase Project Settings.
# Do not place service-account credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local-only mode uses demo-prizecheck and never a live project.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
