{
  "name": "pokemon-tcg-prize-checker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "sync:tcg-data": "node scripts/sync-tcg-data.mjs",
    "build:card-index": "node scripts/build-card-index.mjs",
    "refresh:tcg-data": "npm run sync:tcg-data && npm run build:card-index",
    "smoke:data": "node scripts/smoke-card-index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run smoke:data",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-prizecheck",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "check:rules": "firebase emulators:exec --only auth,firestore --project demo-prizecheck \"npm run test:rules\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.454.0",
    "next": "^16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "latest",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.30.0",
    "postcss": "^8.5.25",
    "tailwindcss": "4.1.17",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
